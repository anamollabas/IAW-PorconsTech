#!/usr/bin/env bash
set -euo pipefail

if [[ ! -f .env ]]; then
  echo "❌ No s'ha trobat el fitxer .env"
  exit 1
fi

# shellcheck disable=SC1091
source .env

echo "▶ Actualitzant paquets..."
sudo apt update

echo "▶ Instal·lant MySQL Server i Git..."
sudo DEBIAN_FRONTEND=noninteractive apt install -y mysql-server git

echo "▶ Activant MySQL..."
sudo systemctl enable --now mysql

CONFIG_FILE="/etc/mysql/mysql.conf.d/mysqld.cnf"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "❌ No s'ha trobat $CONFIG_FILE"
  echo "Revisa la instal·lació de MySQL abans de continuar."
  exit 1
fi

echo "▶ Configurant bind-address = ${DB_PRIVATE_IP}..."
if grep -Eq '^[[:space:]]*bind-address[[:space:]]*=' "$CONFIG_FILE"; then
  sudo sed -i -E \
    "s|^[[:space:]]*bind-address[[:space:]]*=.*|bind-address = ${DB_PRIVATE_IP}|" \
    "$CONFIG_FILE"
else
  sudo sed -i "/^\[mysqld\]/a bind-address = ${DB_PRIVATE_IP}" "$CONFIG_FILE"
fi

echo "▶ Reiniciant MySQL..."
sudo systemctl restart mysql

echo "▶ Creant base de dades i usuari..."
sudo mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\`
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_unicode_ci;

CREATE USER IF NOT EXISTS '${DB_USER}'@'${WEB_PRIVATE_IP}'
  IDENTIFIED BY '${DB_PASSWORD}';

ALTER USER '${DB_USER}'@'${WEB_PRIVATE_IP}'
  IDENTIFIED BY '${DB_PASSWORD}';

GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.*
  TO '${DB_USER}'@'${WEB_PRIVATE_IP}';

FLUSH PRIVILEGES;
SQL

echo "▶ Descarregant l'aplicació per importar la BD inicial..."
sudo rm -rf /tmp/iaw-practica-lamp
git clone --depth 1 "$APP_REPO" /tmp/iaw-practica-lamp

if [[ ! -f /tmp/iaw-practica-lamp/db/database.sql ]]; then
  echo "❌ No s'ha trobat db/database.sql al repositori."
  exit 1
fi

echo "▶ Important: la importació està pensada per a la BD d'aquesta pràctica."
sudo mysql "$DB_NAME" < /tmp/iaw-practica-lamp/db/database.sql

echo "▶ Comprovant servei i port..."
sudo systemctl is-active --quiet mysql
sudo ss -ltnp | grep 3306 || true

echo "✅ Backend MySQL configurat."
